---
// Search index is derived from src/nav.mjs, so every page in the nav tree is
// searchable by construction. Adding a page there adds it here.
import { paletteItems, NAV_ICONS } from '../nav.mjs';

const allItems = paletteItems();
---

<div
  id="command-palette"
  class="cp-overlay"
  data-items={JSON.stringify(allItems)}
  data-icons={JSON.stringify(NAV_ICONS)}
  hidden
>
  <div class="cp-panel">
    <div class="cp-input-row">
      <svg class="cp-search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <input id="cp-input" class="cp-input" type="text" placeholder="Search pages, guides, commands..." autocomplete="off" />
      <kbd class="cp-esc">ESC</kbd>
    </div>
    <div id="cp-results" class="cp-results"></div>
    <div class="cp-footer">
      <span>&#8593;&#8595; navigate</span>
      <span>&#8629; open</span>
      <span>ESC close</span>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  var overlay = document.getElementById('command-palette');
  var input = document.getElementById('cp-input');
  var resultsEl = document.getElementById('cp-results');
  if (!overlay || !input || !resultsEl) return;

  var items = JSON.parse(overlay.dataset.items || '[]');
  var icons = JSON.parse(overlay.dataset.icons || '{}');
  var activeIdx = 0;
  var filtered = items.slice();

  function groupIcon(icon) {
    var inner = icons[icon] || icons.file || '';
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"'
      + ' stroke-linecap="round" stroke-linejoin="round">' + inner + '</svg>';
  }

  // Labels and descriptions are contributor-authored in src/nav.mjs, and they
  // land in innerHTML below — escape rather than trusting every future entry.
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function render() {
    var html = '';
    var currentGroup = '';
    filtered.forEach(function(item, i) {
      if (item.group !== currentGroup) {
        currentGroup = item.group;
        html += '<div class="cp-group-label">' + esc(currentGroup) + '</div>';
      }
      var cls = 'cp-item' + (i === activeIdx ? ' cp-active' : '');
      var enterBadge = i === activeIdx ? '<kbd class="cp-enter-badge">↵</kbd>' : '';
      html += '<a href="' + esc(item.href) + '" class="' + cls + '" data-idx="' + i + '">'
        + '<span class="cp-item-icon">' + groupIcon(item.icon) + '</span>'
        + '<span class="cp-item-text">'
        + '<span class="cp-item-title">' + esc(item.title) + '</span>'
        + '<span class="cp-item-desc">' + esc(item.desc) + '</span>'
        + '</span>'
        + enterBadge
        + '</a>';
    });
    if (filtered.length === 0) {
      html = '<div class="cp-empty">No results found</div>';
    }
    resultsEl.innerHTML = html;
    var active = resultsEl.querySelector('.cp-active');
    if (active) active.scrollIntoView({ block: 'nearest' });
  }

  function updateActive() {
    var prev = resultsEl.querySelector('.cp-active');
    var prevBadge = resultsEl.querySelector('.cp-enter-badge');
    if (prev) prev.classList.remove('cp-active');
    if (prevBadge) prevBadge.remove();
    var next = resultsEl.querySelector('[data-idx="' + activeIdx + '"]');
    if (next) {
      next.classList.add('cp-active');
      var badge = document.createElement('kbd');
      badge.className = 'cp-enter-badge';
      badge.textContent = '↵';
      next.appendChild(badge);
      next.scrollIntoView({ block: 'nearest' });
    }
  }

  function open() {
    overlay.hidden = false;
    input.value = '';
    filtered = items.slice();
    activeIdx = 0;
    render();
    requestAnimationFrame(function() { input.focus(); });
  }

  function close() {
    overlay.hidden = true;
    input.blur();
  }

  function filter() {
    var q = input.value.toLowerCase().trim();
    if (!q) {
      filtered = items.slice();
    } else {
      filtered = items.filter(function(item) {
        return item.title.toLowerCase().indexOf(q) !== -1
          || item.desc.toLowerCase().indexOf(q) !== -1
          || item.group.toLowerCase().indexOf(q) !== -1;
      });
    }
    activeIdx = 0;
    render();
  }

  function navigate(item) {
    close();
    window.location.href = item.href;
  }

  input.addEventListener('input', filter);

  input.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, filtered.length - 1);
      updateActive();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
      updateActive();
    } else if (e.key === 'Enter' && filtered[activeIdx]) {
      e.preventDefault();
      navigate(filtered[activeIdx]);
    } else if (e.key === 'Escape') {
      e.preventDefault();
      close();
    }
  });

  resultsEl.addEventListener('click', function(e) {
    var link = e.target.closest('.cp-item');
    if (link) {
      e.preventDefault();
      var idx = parseInt(link.dataset.idx, 10);
      if (filtered[idx]) navigate(filtered[idx]);
    }
  });

  resultsEl.addEventListener('mouseover', function(e) {
    var link = e.target.closest('.cp-item');
    if (link) {
      var idx = parseInt(link.dataset.idx, 10);
      if (idx !== activeIdx) {
        activeIdx = idx;
        updateActive();
      }
    }
  });

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) close();
  });

  // Ctrl+K / Cmd+K shortcut
  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (overlay.hidden) open();
      else close();
    }
  });

  // Wire up search button trigger
  window.__openCommandPalette = open;
})();
</script>

<style is:global>
  .cp-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .cp-overlay[hidden] {
    display: none;
  }

  /* Item 5 — open animation: overlay fades, panel pops (scale .96→1). Runs each
     time the overlay un-hides. Exit is instant (hidden), matching core dialogs. */
  .cp-overlay:not([hidden]) {
    animation: cp-overlay-in 150ms ease-out;
  }
  .cp-overlay:not([hidden]) .cp-panel {
    animation: cp-panel-in 150ms ease-out;
  }

  @keyframes cp-overlay-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes cp-panel-in {
    from { opacity: 0; transform: scale(0.96); }
    to   { opacity: 1; transform: scale(1); }
  }

  .cp-panel {
    width: 100%;
    max-width: 520px;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 60vh;
  }

  .cp-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .cp-search-icon {
    flex-shrink: 0;
    color: var(--sl-color-gray-2);
  }

  .cp-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 15px;
    color: var(--sl-color-text);
  }

  .cp-input::placeholder {
    color: var(--sl-color-gray-2);
  }

  .cp-esc {
    flex-shrink: 0;
    font-family: var(--sl-font-mono);
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 3px;
    color: var(--sl-color-gray-3);
    background: var(--sl-color-hairline-light);
    border: 1px solid var(--sl-color-hairline);
  }

  .cp-results {
    overflow-y: auto;
    padding: 6px 0;
    flex: 1;
  }

  .cp-group-label {
    font-family: var(--sl-font-mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sl-color-gray-3);
    padding: 6px 16px 2px;
  }

  .cp-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    text-decoration: none;
    color: var(--sl-color-text);
    cursor: pointer;
    transition: background-color 100ms ease;
    border-left: 2px solid transparent;
  }

  .cp-item.cp-active {
    background: var(--sl-color-hairline-light);
    border-left-color: var(--docs-green, #10c0f0);
  }

  .cp-item-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--sl-color-gray-2);
  }

  .cp-item-icon svg {
    width: 20px;
    height: 20px;
  }

  .cp-item-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .cp-item-title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--sl-color-text);
  }

  .cp-item-desc {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 11px;
    color: var(--sl-color-gray-2);
    margin-top: 1px;
  }

  .cp-enter-badge {
    flex-shrink: 0;
    font-family: var(--sl-font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--sl-color-hairline-light);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
  }

  .cp-empty {
    padding: 24px 16px;
    text-align: center;
    color: var(--sl-color-gray-2);
    font-size: 13px;
  }

  .cp-footer {
    display: flex;
    gap: 16px;
    padding: 8px 16px;
    border-top: 1px solid var(--sl-color-hairline);
    font-family: var(--sl-font-mono);
    font-size: 11px;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 50rem) {
    .cp-panel {
      margin: 0 16px;
      max-height: 70vh;
    }

    .cp-overlay {
      padding-top: 10vh;
    }
  }
</style>
