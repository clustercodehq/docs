---
// The mobile bottom bar. Its pinned tabs come from src/nav.mjs, the same tree
// that builds the sidebar, the header nav and the search index — so a section
// can no longer reach the desktop nav without also reaching the mobile menu.
//
// The MENU itself is no longer here. It used to be a slide-up sheet rendered as
// a sibling of this bar; it is now the behind-the-body drawer in
// MobileDrawer.astro (rendered before `.page` in PageFrame.astro, because that
// layer has to sit UNDER the page card in DOM order). This bar only carries the
// trigger — `data-cc-drawer-toggle`, which MobileDrawer's script owns.
import { pinnedGroups, activeGroupLabel } from '../nav.mjs';
import NavIcon from './NavIcon.astro';

const currentPath = Astro.url.pathname;

const pinnedItems = [
  ...pinnedGroups(),
  { key: 'Search', label: 'Search', href: '#', icon: 'search', action: 'search' },
];

// Match on group membership, not path prefix: /concepts/automation/ belongs to
// AI Workforce even though it sits under /concepts/.
const activeGroup = activeGroupLabel(currentPath);
const isActive = (key: string) => key === activeGroup;

// `aria-current` for an active tab, as the console's NavPill derives it: the
// tab lights up for its whole section, but only the section's own landing page
// is the "page"; anywhere else inside it the tab is the current "location".
const ariaCurrent = (key: string, href: string) =>
  isActive(key) ? (href === currentPath ? 'page' : 'location') : undefined;
---

{/* The console's mobile bottom bar, transcribed from the platform's NavPill
    (platform/packages/ui/src/components/nav-pill + the `.nav-pill` block in its
    theme.css): a floating glass pill, icon-only tabs, and the active tab grown
    into its own tinted lozenge that shows the label. The console's raised
    centre action has no counterpart here and is left out. Idle tabs keep their
    name in `aria-label`; the label element is only shown on the active tab.
    Styles: the BOTTOM NAV block in src/styles/custom.css. */}

<nav class="bottom-nav" aria-label="Mobile navigation">
  <div class="bottom-nav-cell" data-align="start">
    <button
      class="bottom-nav-item"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="cc-mobile-drawer"
      data-cc-drawer-toggle
    >
      <span class="bottom-nav-icon">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none">
          <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="bottom-nav-label">Menu</span>
    </button>
  </div>
  {pinnedItems.map((item, i) => (
    <div class="bottom-nav-cell" data-align={i === pinnedItems.length - 1 ? 'end' : 'center'}>
      {item.action === 'search' ? (
        <button class="bottom-nav-item" type="button" aria-label={item.label} data-bottom-nav-search>
          <span class="bottom-nav-icon"><NavIcon name="search" /></span>
          <span class="bottom-nav-label">{item.label}</span>
        </button>
      ) : (
        <a
          href={item.href}
          class:list={['bottom-nav-item', { active: isActive(item.key) }]}
          aria-label={item.label}
          aria-current={ariaCurrent(item.key, item.href)}
        >
          <span class="bottom-nav-icon"><NavIcon name={item.icon} /></span>
          <span class="bottom-nav-label">{item.label}</span>
        </a>
      )}
    </div>
  ))}
</nav>

<script is:inline>
  (function () {
    var searchBtn = document.querySelector('[data-bottom-nav-search]');
    if (!searchBtn) return;
    searchBtn.addEventListener('click', function () {
      // The palette is a fixed overlay inside the page card; opening it while
      // the card is parked aside would render it scaled and out of reach.
      if (window.__ccMobileDrawer) window.__ccMobileDrawer.close();
      if (window.__openCommandPalette) window.__openCommandPalette();
    });
  })();
</script>
