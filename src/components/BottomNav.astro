---
// Groups come from src/nav.mjs, the same tree that builds the sidebar, the
// header nav and the search index — so a section can no longer reach the
// desktop nav without also reaching the mobile menu.
import { menuTree, pinnedGroups, activeGroupLabel } from '../nav.mjs';
import NavIcon from './NavIcon.astro';

const currentPath = Astro.url.pathname;

const pinnedItems = [
  ...pinnedGroups(),
  { key: 'Search', label: 'Search', href: '#', icon: 'search', action: 'search' },
];

// Match on group membership, not path prefix: /concepts/automation/ belongs to
// Automation even though it sits under /concepts/.
const activeGroup = activeGroupLabel(currentPath);
const isActive = (key: string) => key === activeGroup;

// Nested sections, with Beta chips and the current page already resolved by
// nav.mjs — nothing about the tree is restated here.
const tree = menuTree(currentPath);
---

<div class="bottom-nav-backdrop" data-bottom-nav-backdrop></div>

<div class="bottom-nav-menu" data-bottom-nav-panel>
  {tree.map((group) => (
    <details class="bn-group" open={group.open}>
      <summary class:list={['bottom-nav-menu-item', 'bn-group-row', { active: group.active }]}>
        <NavIcon name={group.icon} />
        <span class="bn-group-label">{group.label}</span>
        <svg
          class="bn-chevron"
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </summary>
      <ul class="bn-sublist">
        {group.items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['bn-subitem', { current: item.current }]}
              aria-current={item.current ? 'page' : undefined}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="bn-subitem-label">{item.label}</span>
              {item.badge && <span class="sl-badge beta-badge bn-badge">{item.badge}</span>}
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</div>

<nav class="bottom-nav" aria-label="Mobile navigation">
  <button class="bottom-nav-item" aria-label="Menu" data-bottom-nav-menu>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <span>Menu</span>
  </button>
  {pinnedItems.map((item) => (
    item.action === 'search' ? (
      <button class="bottom-nav-item" aria-label="Search" data-bottom-nav-search>
        <NavIcon name="search" />
        <span>{item.label}</span>
      </button>
    ) : (
      <a href={item.href} class:list={['bottom-nav-item', { active: isActive(item.key) }]}>
        <NavIcon name={item.icon} />
        <span>{item.label}</span>
      </a>
    )
  ))}
</nav>

<script is:inline>
  (function() {
    var menuBtn = document.querySelector('[data-bottom-nav-menu]');
    var panel = document.querySelector('[data-bottom-nav-panel]');
    var backdrop = document.querySelector('[data-bottom-nav-backdrop]');

    var closeTimer;
    function finishClose() {
      if (panel) panel.classList.remove('open', 'closing');
      if (backdrop) backdrop.classList.remove('open', 'closing');
    }
    function closeMenu() {
      if (menuBtn) menuBtn.classList.remove('active');
      var isOpen = panel && panel.classList.contains('open');
      var reduce = typeof matchMedia !== 'undefined'
        && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!isOpen || reduce) {
        finishClose();
        return;
      }
      // Play a matching slide-down/fade exit, then remove .open (display:none).
      if (panel) panel.classList.add('closing');
      if (backdrop) backdrop.classList.add('closing');
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(finishClose, 130);
    }

    function toggleMenu() {
      var isOpen = panel && panel.classList.contains('open');
      if (isOpen) {
        closeMenu();
      } else {
        if (panel) panel.classList.add('open');
        if (backdrop) backdrop.classList.add('open');
        if (menuBtn) menuBtn.classList.add('active');
      }
    }

    if (menuBtn) menuBtn.addEventListener('click', toggleMenu);
    if (backdrop) backdrop.addEventListener('click', closeMenu);

    var searchBtn = document.querySelector('[data-bottom-nav-search]');
    if (searchBtn) {
      searchBtn.addEventListener('click', function() {
        closeMenu();
        if (window.__openCommandPalette) window.__openCommandPalette();
      });
    }
  })();
</script>
