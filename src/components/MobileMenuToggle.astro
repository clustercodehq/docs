---
/**
 * Override of Starlight's mobile menu toggle.
 *
 * Starlight's version flips `aria-expanded` on itself, which its own CSS reads
 * (`[aria-expanded='true'] ~ .sidebar-pane`) to slide `#starlight__sidebar` in
 * as a full-screen overlay. This site does not use that menu: the mobile menu is
 * the behind-the-body drawer in MobileDrawer.astro, triggered from the bottom
 * bar. Rather than leave Starlight's menu wired up underneath ours — two menus,
 * one of them reachable by keyboard only and showing a different tree — this
 * custom element is re-pointed at the drawer and never sets `aria-expanded` on
 * itself, so the Starlight pane can no longer be revealed.
 *
 * The button stays in the markup (hidden — see the style block, and the
 * `starlight-menu-button { display: none }` rule in custom.css) because
 * Starlight's PageFrame slot contract expects the element, and because keeping
 * one custom element means one place to notice if a Starlight upgrade changes
 * how the pane is shown.
 */
---

<starlight-menu-button class="print:hidden">
	<button
		type="button"
		aria-expanded="false"
		aria-label={Astro.locals.t('menuButton.accessibleLabel')}
		aria-controls="cc-mobile-drawer"
		class="sl-flex md:sl-hidden mobile-menu-btn"
		data-cc-drawer-toggle
	>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="open-menu">
			<line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line>
		</svg>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-menu">
			<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
		</svg>
	</button>
</starlight-menu-button>

<script>
	class StarlightMenuButton extends HTMLElement {
		btn = this.querySelector('button')!;

		constructor() {
			super();
			// The click itself is handled by MobileDrawer.astro's delegated
			// listener (it owns every `[data-cc-drawer-toggle]`), so there is
			// nothing to bind here — only Escape, which Starlight scoped to the
			// surrounding <nav> and which the drawer also handles document-wide.
			const parentNav = this.closest('nav');
			if (parentNav) {
				parentNav.addEventListener('keyup', (e) => this.closeOnEscape(e));
			}
		}

		closeOnEscape(e: KeyboardEvent) {
			if (e.code === 'Escape') {
				(window as any).__ccMobileDrawer?.close();
				this.btn.focus();
			}
		}
	}

	customElements.define('starlight-menu-button', StarlightMenuButton);
</script>

<style>
	button {
		display: none;
	}
</style>
